{
	"name": "zh-bible-sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"migration:keys": "node scripts/migration/audit-localstorage-keys.mjs",
		"migration:compare": "node scripts/migration/compare-localstorage-snapshots.mjs",
		"migration:stage:legacy": "node scripts/migration/stage-host-content.mjs legacy",
