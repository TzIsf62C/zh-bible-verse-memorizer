		"test": "vitest run",
		"look": "node tools/look/cli.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@testing-library/svelte": "^5.2.8",
		"jsdom": "^26.1.0",
		"playwright": "^1.62.1",
		"puppeteer-core": "^25.3.0",
		"svelte": "^5.49.2",
		"vite": "^7.3.1",
		"vitest": "^3.2.4"
	}
